--- /tmp/cpu_upstream.c	2026-11-09 18:35:04.469443339 -0700
+++ core/tamalib/cpu.c	2026-11-09 18:45:03.706058376 -0700
@@ -1938,7 +1938,12 @@
 int cpu_step(void)
 {
 	u12_t op;
-	u8_t i;
+	/* Initialised on purpose. When cpu_halted is set the lookup loop below
+	 * does not run, but `i` is still read by the interrupt-dispatch test
+	 * (`if (I && i != 0 && i != 58)`). Upstream leaves it uninitialised, so a
+	 * halted CPU's interrupt behaviour depended on stack garbage - which made
+	 * the same ROM halt at different addresses in different builds. */
+	u8_t i = 0;
 	breakpoint_t *bp = g_breakpoints;
 	static u8_t previous_cycles = 0;
 
@@ -1999,7 +2004,13 @@
 	handle_timers();
 
 	/* Check if there is any pending interrupt */
-	if (I && i != 0 && i != 58) { // Do not process interrupts after a PSET or EI operation
+	/* A halted CPU must still take interrupts - that is how it wakes.
+	 * The PSET/EI exclusion below only makes sense when an opcode actually just
+	 * executed, which is exactly when cpu_halted is clear. Upstream tests `i`
+	 * unconditionally, and `i` is uninitialised on the halted path, so wakeup
+	 * depended on stack garbage: correct by luck on most builds, and broken the
+	 * moment the byte happened to be 0. */
+	if (I && (cpu_halted || (i != 0 && i != 58))) { // Do not process interrupts after a PSET or EI operation
 		process_interrupts();
 	}
 
